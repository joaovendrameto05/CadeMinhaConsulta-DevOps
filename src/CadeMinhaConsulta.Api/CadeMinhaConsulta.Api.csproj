<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CadeMinhaConsulta.Api</AssemblyName>
    <RootNamespace>CadeMinhaConsulta.Api</RootNamespace>
    <UserSecretsId>VagaCerta.Api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26400" />
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Use a patched PKCS version in place of the Oracle driver's transitive minimum. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CadeMinhaConsulta.InfrastructureTests" />
  </ItemGroup>
</Project>
